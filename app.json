{
  "expo": {
    "name": "Fitness Royale",
    "slug": "fitness-royale",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0F1218"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.fitnessroyale.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#060708"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiUrl": "https://fitnessroyale.onrender.com",
      "eas": {
        "projectId": "534a0816-7157-49da-8bc1-7a9fd016784b"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Fitness Royale a besoin d'accéder à tes vidéos pour prouver tes performances."
        }
      ]
    ]
  }
}
